# Miku — local secrets. Copy to `.env` and fill in. `.env` is gitignored; never commit real keys.
#
#   cp .env.example .env
#
# Used from M1 on (the hybrid router sends task/tool turns to Claude).
# Rotate any key that has ever been pasted into a chat, terminal, or shared file.
ANTHROPIC_API_KEY=

# Picovoice access key for the "Miku" wake word (used from M4, inside the native app).
# Free personal key: https://console.picovoice.ai/
PICOVOICE_ACCESS_KEY=
