# Ollama model for Miku's local brain.
# Base: Qwen2.5 7B Instruct (strong Spanish + native tool-calling).
# The only real change vs. stock is a much larger context window: the MCP tool
# schemas (web search, etc.) plus Miku's persona overflow Ollama's default
# num_ctx (2048), which silently truncates the tools and makes the model
# hallucinate instead of calling them.
#
# Build / rebuild:
#   ollama create qwen2.5-miku -f Modelfile.miku
FROM qwen2.5:7b

PARAMETER num_ctx 8192
PARAMETER temperature 0.8
