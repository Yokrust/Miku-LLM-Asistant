    <string>Miku</string>
    <key>CFBundleIdentifier</key>
    <string>com.yokrust.miku</string>
    <key>CFBundleExecutable</key>
    <string>Miku</string>
    <key>CFBundleIconFile</key>
    <string>Miku</string>
